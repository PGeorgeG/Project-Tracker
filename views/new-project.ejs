<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New project</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="wrap" style="max-width:600px;">
    <div class="topbar">
      <h1>New project</h1>
      <a class="btn" href="/">Cancel</a>
    </div>

    <div class="card">
      <form method="POST" action="/projects">
        <div class="form-group">
          <label for="name">Project name</label>
          <input type="text" id="name" name="name" required placeholder="e.g. Nukus teacher certificate program">
        </div>

        <div class="form-group">
          <label for="outcome">Outcome / goal</label>
          <textarea id="outcome" name="outcome" required placeholder="What does done look like for this project?&#10;Start a line with - for a bullet point"></textarea>
        </div>

        <div class="form-group">
          <label for="lead_name">Project lead</label>
          <input type="text" id="lead_name" name="lead_name" required placeholder="Who runs the day-to-day plan">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="start_date">Start date</label>
            <input type="date" id="start_date" name="start_date" required>
          </div>
          <div class="form-group">
            <label for="end_date">End date</label>
            <input type="date" id="end_date" name="end_date" required>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="status_tag">Status</label>
            <select id="status_tag" name="status_tag">
              <option value="">Not set</option>
              <% STATUS_TAGS.forEach(function(t) { %>
                <option value="<%= t %>"><%= t %></option>
              <% }); %>
            </select>
          </div>
          <div class="form-group">
            <label for="cadence">Meeting cadence</label>
            <select id="cadence" name="cadence">
              <option value="">Not set</option>
              <% CADENCES.forEach(function(c) { %>
                <option value="<%= c %>"><%= c %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="color">Dashboard color</label>
          <input type="color" id="color" name="color" value="#378ADD" style="width:60px; height:36px; padding:2px;">
        </div>

        <p class="empty-state" style="margin-bottom:1rem;">
          Stages are optional here — add them later once the lead's plan is worked out.
        </p>

        <button type="submit" class="btn btn-primary">Create project</button>
      </form>
    </div>
  </div>
</body>
</html>
