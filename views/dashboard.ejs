<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Project Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="wrap wrap-wide">
    <div class="topbar">
      <h1>Project Tracker</h1>
      <div style="display:flex; gap:8px;">
        <a class="btn btn-icon" href="/search" title="Search" aria-label="Search">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </a>
        <div class="dropdown">
          <button type="button" class="btn" id="moreMenuBtn">More &#9662;</button>
          <div class="dropdown-menu" id="moreMenu" style="display:none;">
            <a href="/report">Report</a>
            <a href="/?archived=<%= showArchived ? '0' : '1' %>"><%= showArchived ? 'Show active' : 'Show archived' %></a>
            <a href="/completed-todos">Completed todos</a>
          </div>
        </div>
        <a class="btn btn-primary" href="/projects/new">New project</a>
        <form method="POST" action="/logout" style="display:inline;">
          <button type="submit" class="btn btn-small">Log out</button>
        </form>
      </div>
    </div>

    <div class="dashboard-grid">
      <div class="dashboard-main">
        <% if (projects.length === 0) { %>
          <div class="card">
            <p class="empty-state">
              <% if (showArchived) { %>No archived projects.<% } else { %>No active projects yet. Create your first one to get started.<% } %>
            </p>
          </div>
        <% } %>

    <% projects.forEach(function(p, idx) { %>
      <div class="project-item" style="border-left: 4px solid <%= p.color %>;">
        <div class="project-row-header">
          <div class="move-buttons">
            <form method="POST" action="/projects/<%= p.id %>/move">
              <input type="hidden" name="direction" value="up">
              <button type="submit" class="btn btn-small" <%= idx === 0 ? 'disabled' : '' %> title="Move up">&uarr;</button>
            </form>
            <form method="POST" action="/projects/<%= p.id %>/move">
              <input type="hidden" name="direction" value="down">
              <button type="submit" class="btn btn-small" <%= idx === projects.length - 1 ? 'disabled' : '' %> title="Move down">&darr;</button>
            </form>
          </div>
          <div class="quick-add-buttons">
            <button type="button" class="btn btn-small quick-todo-btn" data-project-id="<%= p.id %>" data-project-name="<%= p.name %>" title="Quick add a todo">+ Todo</button>
            <button type="button" class="btn btn-small quick-note-btn" data-project-id="<%= p.id %>" data-project-name="<%= p.name %>" title="Quick add a note">+ Note</button>
          </div>
          <details class="project-details">
            <summary class="project-summary">
              <span class="summary-chevron">&rsaquo;</span>
              <span class="project-badge" style="border-color:<%= p.color %>; color:<%= p.color %>;"><%= p.icon || p.name.charAt(0).toUpperCase() %></span>
              <h2><%= p.name %></h2>
              <span class="proj-lead"><%= p.lead_name %></span>
              <% if (p.status_tag) { %>
                <span class="badge badge-<%= p.status_tag.replace(' ', '-') %>"><%= p.status_tag %></span>
              <% } %>
              <% if (p.openAlerts > 0) { %><span class="badge badge-at-risk"><%= p.openAlerts %> alert<%= p.openAlerts > 1 ? 's' : '' %></span><% } %>
              <% if (p.openTodos.length > 0) { %><span class="badge badge-count"><%= p.openTodos.length %> open todo<%= p.openTodos.length > 1 ? 's' : '' %></span><% } %>
            </summary>

            <div class="project-body" onclick="if(!event.target.closest('a, form, button, input, label')) window.location='/projects/<%= p.id %>'">
              <div class="proj-outcome"><%- renderOutcome(p.outcome) %></div>
              <div class="meta-row">
                <% if (p.status_tag) { %>
                  <span class="badge badge-<%= p.status_tag.replace(' ', '-') %>"><%= p.status_tag %></span>
                <% } %>
                <% if (p.cadence) { %><span class="badge badge-count"><%= p.cadence %> check-ins</span><% } %>
                <% if (p.openAlerts > 0) { %><span class="badge badge-at-risk"><%= p.openAlerts %> alert<%= p.openAlerts > 1 ? 's' : '' %></span><% } %>
                <% if (p.openTodos.length > 0) { %><span class="badge badge-count"><%= p.openTodos.length %> open todo<%= p.openTodos.length > 1 ? 's' : '' %></span><% } %>
              </div>
              <% if (p.stages.length > 0) { %>
                <div class="timeline-mount" data-interactive="false" style="--accent: <%= p.color %>;">
                  <script type="application/json" class="timeline-json"><%- safeJson({
                    start: p.start_date,
                    end: p.end_date,
                    stages: p.stages,
                    notes: p.notes,
                    progressPct: (function() {
                      const done = p.stages.filter(s => s.status === "done").length;
                      return p.stages.length ? Math.round((done / p.stages.length) * 100) : 0;
                    })()
                  }) %></script>
                </div>
              <% } else { %>
                <p class="empty-state">No stages added yet.</p>
              <% } %>

              <% if (p.openTodos.length > 0) { %>
                <div class="tile-todos">
                  <p class="tile-links-title">Todos</p>
                  <% p.openTodos.forEach(function(t) { %>
                    <% const urgency = todoUrgency(t.due_date); %>
                    <form method="POST" action="/projects/<%= p.id %>/todos/<%= t.id %>/toggle" class="tile-todo-row">
                      <input type="hidden" name="redirect_to" value="/">
                      <label class="<%= urgency === 'overdue' ? 'todo-overdue' : (urgency === 'soon' ? 'todo-soon' : '') %>">
                        <input type="checkbox" onchange="this.form.submit()">
                        <span><%= t.text %><% if (t.due_date) { %> <span class="muted">— <%= t.due_date %></span><% } %></span>
                      </label>
                    </form>
                  <% }); %>
                </div>
              <% } %>

              <% if (p.links.length > 0) { %>
                <div class="tile-links">
                  <p class="tile-links-title">Related links</p>
                  <% p.links.forEach(function(l) { %>
                    <a href="<%= l.url %>" target="_blank" rel="noopener noreferrer"><%= l.description %></a>
                  <% }); %>
                </div>
              <% } %>

              <a class="open-project-link" href="/projects/<%= p.id %>">Open project &rarr;</a>
            </div>
          </details>
        </div>
      </div>
    <% }); %>
      </div>

      <aside class="dashboard-sidebar">
        <div class="card">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <p class="section-title" style="margin:0;">Today</p>
            <% if (todayListTodos.length > 0 || todayListAlerts.length > 0) { %>
              <button type="button" class="btn btn-small" id="copyTodayListBtn">Copy list</button>
            <% } %>
          </div>
          <% if (todayListTodos.length === 0 && todayListAlerts.length === 0) { %>
            <p class="empty-state">Right-click (or tap &#8942;) a todo or alert to add it here.</p>
          <% } %>
          <% todayListTodos.forEach(function(t) { %>
            <div class="today-list-row" data-todo-text="<%= t.text %>" data-project-name="<%= t.project_name %>">
              <form method="POST" action="/projects/<%= t.project_id %>/todos/<%= t.id %>/toggle" style="display:inline;">
                <input type="hidden" name="redirect_to" value="/">
                <label>
                  <input type="checkbox" onchange="this.form.submit()">
                  <span><%= t.text %></span>
                </label>
              </form>
              <form method="POST" action="/projects/<%= t.project_id %>/todos/<%= t.id %>/today/remove">
                <input type="hidden" name="redirect_to" value="/">
                <button type="submit" class="today-remove-btn" title="Remove from Today">&times;</button>
              </form>
            </div>
          <% }); %>
          <% todayListAlerts.forEach(function(a) { %>
            <div class="today-list-row" data-todo-text="<%= a.note %>" data-project-name="<%= a.project_name %>">
              <span class="today-alert-label"><span class="today-alert-tag">Alert</span> <%= a.note %></span>
              <form method="POST" action="/projects/<%= a.project_id %>/alerts/<%= a.id %>/today/remove">
                <input type="hidden" name="redirect_to" value="/">
                <button type="submit" class="today-remove-btn" title="Remove from Today">&times;</button>
              </form>
            </div>
          <% }); %>
        </div>

        <div class="card">
          <details class="alerts-details">
            <summary class="alerts-summary">
              <span class="summary-chevron">&rsaquo;</span>
              <p class="section-title" style="margin:0;">Alerts<% if (globalAlerts.length > 0) { %> (<%= globalAlerts.length %>)<% } %></p>
            </summary>
            <div class="alerts-body">
              <% if (globalAlerts.length === 0) { %>
                <p class="empty-state">No open alerts.</p>
              <% } %>
              <% globalAlerts.forEach(function(a) { %>
                <% const onToday = a.today_list_date === todayStr; %>
                <div class="global-todo-row global-alert-row" data-type="alert" data-project-id="<%= a.project_id %>" data-todo-id="<%= a.id %>" data-on-today="<%= onToday %>">
                  <form method="POST" action="/projects/<%= a.project_id %>/alerts/<%= a.id %>/dismiss">
                    <input type="hidden" name="redirect_to" value="/">
                    <label class="dismiss-alert-label">
                      <input type="checkbox" onchange="this.form.submit()" title="Dismiss alert">
                      <span class="global-todo-text"><%= a.note %></span>
                    </label>
                  </form>
                  <div class="global-todo-meta">
                    <span class="project-dot" style="background:<%= a.project_color %>;"></span>
                    <a href="/projects/<%= a.project_id %>"><%= a.project_name %></a>
                    <span class="muted">— <%= a.trigger_date %></span>
                    <button type="button" class="row-kebab" title="More options">&#8942;</button>
                  </div>
                </div>
              <% }); %>
            </div>
          </details>
        </div>

        <div class="card">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <p class="section-title" style="margin:0;">Upcoming todos</p>
            <a class="btn btn-small" href="/board">Sticky Board</a>
          </div>
          <% if (globalTodos.length === 0) { %>
            <p class="empty-state">Nothing with a due date right now.</p>
          <% } %>
          <% globalTodos.forEach(function(t) { %>
            <% const urgency = todoUrgency(t.due_date); %>
            <% const onToday = t.today_list_date === todayStr; %>
            <div class="global-todo-row" data-type="todo" data-project-id="<%= t.project_id %>" data-todo-id="<%= t.id %>" data-on-today="<%= onToday %>">
              <form method="POST" action="/projects/<%= t.project_id %>/todos/<%= t.id %>/toggle">
                <input type="hidden" name="redirect_to" value="/">
                <label class="<%= urgency === 'overdue' ? 'todo-overdue' : (urgency === 'soon' ? 'todo-soon' : '') %>">
                  <input type="checkbox" onchange="this.form.submit()">
                  <span class="global-todo-text"><%= t.text %></span>
                </label>
              </form>
              <div class="global-todo-meta">
                <span class="project-dot" style="background:<%= t.project_color %>;"></span>
                <a href="/projects/<%= t.project_id %>"><%= t.project_name %></a>
                <span class="muted">— <%= t.due_date %></span>
                <button type="button" class="row-kebab" title="More options">&#8942;</button>
              </div>
            </div>
          <% }); %>
        </div>
      </aside>
    </div>
  </div>

  <div id="todoContextMenu" class="context-menu" style="display:none;">
    <button type="button" id="ctxAddToday">Add to Today List</button>
    <button type="button" id="ctxRemoveToday">Remove from Today List</button>
  </div>

  <div id="quickTodoModal" class="quick-todo-overlay" style="display:none;">
    <div class="quick-todo-box">
      <p class="quick-todo-project-name"></p>
      <form method="POST" id="quickTodoForm">
        <input type="hidden" name="redirect_to" value="/">
        <input type="hidden" name="due_date" value="<%= tomorrowStr %>">
        <input type="text" name="text" id="quickTodoInput" placeholder="What needs doing" required autocomplete="off">
        <div class="quick-todo-actions">
          <button type="button" id="quickTodoCancel" class="btn btn-small">Cancel</button>
          <button type="submit" class="btn btn-primary btn-small">Add</button>
        </div>
      </form>
    </div>
  </div>

  <div id="quickNoteModal" class="quick-todo-overlay" style="display:none;">
    <div class="quick-todo-box quick-note-box">
      <p class="quick-todo-project-name"></p>
      <form method="POST" id="quickNoteForm">
        <input type="hidden" name="redirect_to" value="/">
        <input type="hidden" name="meeting_date" id="quickNoteDate" value="<%= todayStr %>">
        <input type="hidden" name="posted_on_timeline" value="on">
        <input type="hidden" name="tone" value="green">
        <textarea name="text" id="quickNoteInput" class="quick-note-textarea" placeholder="Quick note from this meeting" required></textarea>
        <div class="quick-todo-actions">
          <button type="button" id="quickNoteCancel" class="btn btn-small">Cancel</button>
          <button type="submit" class="btn btn-primary btn-small">Add</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/timeline.js"></script>
  <script src="/js/today-list.js"></script>
  <script src="/js/quick-todo.js"></script>
  <script src="/js/quick-note.js"></script>
  <script src="/js/dropdown.js"></script>
</body>
</html>
